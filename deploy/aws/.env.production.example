# Copy to deploy/aws/.env on the EC2 (never commit real secrets).
#   cp deploy/aws/.env.production.example deploy/aws/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cow_track

APP_ENV=production
ADMIN_ENABLED=false
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_CACHE_TTL_SECONDS=86400
APP_PORT=8000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=cow_track
TELEMETRY_RAW_RETENTION_DAYS=30
TELEMETRY_HISTORY_INTERVAL_MINUTES=30

SUPERUSER_EMAIL=admin@apigeobov.com
SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPERUSER_FULL_NAME=Super Admin
