# =============================================================================
# CowTrack API — copy to .env and adjust for your environment
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cow_track
# Host port (5433 avoids conflict with local Postgres on 5432)
POSTGRES_HOST_PORT=5433

# --- Application ---
# local | development → Scalar/Swagger/ReDoc visible
# production → docs hidden (override with DOCS_ENABLED=true/false)
APP_ENV=local
# DOCS_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@db:5432/cow_track
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_CACHE_TTL_SECONDS=86400
APP_PORT=8000

# --- Redis (session cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0

# --- MongoDB (telemetry / hybrid persistence) ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=cow_track
MONGO_HOST_PORT=27017
TELEMETRY_RAW_RETENTION_DAYS=30
TELEMETRY_HISTORY_INTERVAL_MINUTES=30

# --- SQLAdmin (/admin) — login with SUPERUSER_EMAIL / SUPERUSER_PASSWORD ---
# Restrict by reverse-proxy IP allowlist in production; disable with ADMIN_ENABLED=false
ADMIN_ENABLED=true

# --- Dev superuser (python -m app.commands setup / seed) ---
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme
SUPERUSER_FULL_NAME=Super Admin

# --- Local API without Docker (uncomment and use with `make run`) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cow_track
# REDIS_HOST=localhost
# MONGO_URL=mongodb://localhost:27017
