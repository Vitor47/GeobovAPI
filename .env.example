# =============================================================================
# CowTrack API — copy to .env and adjust for your environment
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cow_track
# Host port (5433 avoids conflict with local Postgres on 5432)
POSTGRES_HOST_PORT=5433

# --- Application ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/cow_track
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_CACHE_TTL_SECONDS=86400
APP_PORT=8000

# --- Redis (session cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0

# --- Dev superuser (python -m app.commands setup / seed) ---
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme
SUPERUSER_FULL_NAME=Super Admin

# --- Local API without Docker (uncomment and use with `make run`) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cow_track
# REDIS_HOST=localhost
