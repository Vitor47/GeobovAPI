# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cow_track
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/cow_track

# Application
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_CACHE_TTL_SECONDS=86400
APP_PORT=8000

# Redis (session cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Dev setup (python -m app.commands setup)
SUPERUSER_EMAIL=admin@cowtrack.local
SUPERUSER_PASSWORD=changeme
SUPERUSER_FULL_NAME=Super Admin
